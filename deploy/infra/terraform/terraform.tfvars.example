# Copie para terraform.tfvars (gitignore). 192.168.1.13 é o Proxmox, não a VM.

proxmox_endpoint         = "https://192.168.1.13:8006/"
proxmox_insecure         = true
proxmox_api_token_id     = "terraform-prov@pve!tf-token"
proxmox_api_token_secret = "SEU-TOKEN-AQUI"
proxmox_node_name        = "pve1"

storage_disk_pool     = "zfs"
storage_template_pool = "local"
network_bridge        = "vmbr0"
default_gateway       = "192.168.1.1"

# Template já existente (ubuntu-2404-cloud). Não rode create-cloudinit-template.sh.
vm_template_id    = 9000
# VM nova. No pve1 já existem 201 (nexus), 210 (assistência), 220 (sismarq)
# e 230 (glpi), cada uma com a sua aplicação: não reutilize.
vm_id             = 240
vm_name           = "projeto-nova-prod-app"
app_ipv4          = "192.168.1.70/24"
vm_cores          = 4
vm_memory         = 4096
vm_disk_size      = 60
vm_admin_password = "TroqueEstaSenhaDoConsole"

# Chave do operador que vai rodar o Ansible (máquina com make infra-deploy).
admin_ssh_public_key = "ssh-ed25519 AAAA... admin@infra"

# Homologação (VM 241, 192.168.1.71). Desligada: o pve1 tem 11 GB de RAM.
# homologacao = { criar = true }

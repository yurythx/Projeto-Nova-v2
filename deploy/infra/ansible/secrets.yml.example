# Copie para secrets.yml (gitignore). Não commite.
# make infra-deploy usa -e @secrets.yml se o arquivo existir.

keycloak_client_secret: "COLE-O-SECRET-DO-CLIENT-PROJETO-NOVA"
keycloak_frontend_client_secret: "COLE-O-MESMO-SE-FOR-UM-CLIENT-SO"


# Só para um túnel próprio do Projeto Nova. Hoje a produção usa o
# cloudflared do LXC 101 (cloudflare_conector_ip em group_vars/all.yml) e
# não precisa deste arquivo. Nunca ponha aqui o token do LXC 101.
#
# Copie para cloudflare.secrets.yml (gitignore), ou ponha no cofre
# (make infra-segredos). Não commite.
#
# Um túnel por ambiente: painel Cloudflare > Zero Trust > Networks >
# Tunnels > <túnel> > Configure > o texto depois de "--token". Rotas de
# cada um: docs/DEPLOY.md.

cloudflare_tunnel_token_producao: "COLE-O-TOKEN-DO-TUNEL-projeto-nova-prod"
# cloudflare_tunnel_token_homologacao: "COLE-O-TOKEN-DO-TUNEL-projeto-nova-homolog"

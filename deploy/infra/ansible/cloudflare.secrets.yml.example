# Copie para cloudflare.secrets.yml (gitignore). Não commite.
# make infra-deploy usa -e @cloudflare.secrets.yml se o arquivo existir.
#
# Token do túnel projeto-nova-prod: painel Cloudflare > Zero Trust >
# Networks > Tunnels > projeto-nova-prod > Configure > o texto depois de
# "--token" no comando de instalação. Rotas: docs/DEPLOY.md.

cloudflare_tunnel_token: "COLE-O-TOKEN-DO-TUNEL"
